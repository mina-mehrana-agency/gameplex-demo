---
import { events } from '../../data/events';
import EventCard from '../EventCard.astro';
const list = events.filter((e) => e.status !== 'soldout').slice(0, 3);
---
{list.length > 0 && (
<section class="ev-teaser" id="tickets">
 <div class="wrap">
  <div class="sec-head rv">
   <div>
    <span class="eyebrow">Tickets</span>
    <h2>Tournaments and events this week</h2>
   </div>
   <a class="btn ghost" href="/events">All events and tickets <svg><use href="#i-arrow"/></svg></a>
  </div>
  <ul class="ev-list rv">
   {list.map((e) => <EventCard e={e} compact />)}
  </ul>
 </div>
</section>
)}

<style>
.ev-teaser{background:radial-gradient(700px 400px at 10% 20%,rgba(92,200,255,.12),transparent 70%)}
.ev-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
@media (max-width:1020px){.ev-list{grid-template-columns:1fr}}
</style>

<script>
  import { torontoToday } from '../../lib/global';
  import { fillNextDates } from '../../lib/events';
  fillNextDates(torontoToday());
</script>
