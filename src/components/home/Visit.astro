---
import { site, hours } from '../../data/site';
---
<section class="visit" id="visit">
 <div class="wrap">
  <div class="visit-box rv">
   <div class="visit-copy">
    <span class="eyebrow">Find us</span>
    <h2>Press start</h2>
    <p class="lead">{site.address.street}, {site.address.city}, {site.address.region} {site.address.postal}. {site.areas}</p>
    <div class="ctas">
     <a class="btn" href={site.phoneHref} data-burst><svg><use href="#i-phone"/></svg>Call {site.phone}</a>
     <a class="btn ghost" href={site.mapsUrl} target="_blank" rel="noopener"><svg><use href="#i-pin"/></svg>Get directions</a>
    </div>
    <ul class="hours" aria-label="Opening hours">
     {hours.map((h) => <li data-day={h.day}><span>{h.label}</span><span>{h.time}</span></li>)}
    </ul>
   </div>
   <div class="map">
    <iframe src={site.mapEmbed} title="Map to Gameplex, 8403 Yonge Street, Thornhill" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
   </div>
  </div>
 </div>
</section>

<style>
.visit-box{position:relative;border-radius:34px;background:var(--purple);padding:44px;overflow:hidden;display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:stretch}
.visit-box::after{content:"";position:absolute;width:420px;height:420px;left:-160px;bottom:-220px;border-radius:50%;border:60px solid rgba(255,255,255,.07);pointer-events:none}
.visit-copy{position:relative;z-index:1}
.visit h2{color:#fff}
.visit .lead{color:#EDE2FF}
.ctas{display:flex;gap:12px;flex-wrap:wrap;margin:22px 0 26px}
.hours{list-style:none;margin:0;padding:18px 20px;display:grid;gap:4px;background:rgba(19,7,36,.35);border-radius:20px}
.hours li{display:flex;justify-content:space-between;gap:12px}
.hours li.today{color:var(--ticket);font-weight:800}
.map{position:relative;z-index:1;border-radius:24px;overflow:hidden;min-height:360px;background:var(--grape);border:3px solid rgba(255,255,255,.18)}
.map iframe{position:absolute;inset:0;width:100%;height:100%;border:0;filter:saturate(.9)}
@media (max-width:1020px){.visit-box{grid-template-columns:1fr;padding:26px}}
</style>
